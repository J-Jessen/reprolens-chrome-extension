{
  "manifest_version": 3,
  "name": "Behaviour Tracer PoC",
  "version": "0.1.7",
  "description": "Select an element, perform one interaction, and inspect the resulting browser behaviour.",
  "permissions": [
    "activeTab",
    "debugger",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Behaviour Tracer"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
