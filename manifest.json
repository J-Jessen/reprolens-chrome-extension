{
  "manifest_version": 3,
  "name": "ReproLens Beta",
  "version": "0.11.0",
  "minimum_chrome_version": "118",
  "description": "BETA: Record browser behaviour, create a safe bug report, open a GitHub issue, and generate a Playwright test.",
  "permissions": [
    "alarms",
    "debugger",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open ReproLens"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
