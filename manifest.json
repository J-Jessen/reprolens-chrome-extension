{
  "manifest_version": 3,
  "name": "Behaviour Tracer PoC",
  "version": "0.7.0",
  "description": "Select an element, perform one interaction, and inspect the resulting browser behaviour.",
  "permissions": [
    "debugger",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Behaviour Tracer"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
