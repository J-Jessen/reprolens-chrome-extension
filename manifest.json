{
  "manifest_version": 3,
  "name": "Behaviour Tracer Beta",
  "version": "0.9.0",
  "minimum_chrome_version": "118",
  "description": "BETA: Trace one page interaction and get a diagnostic explanation, framework context, and optional local AI review.",
  "permissions": [
    "debugger",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Behaviour Tracer"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
